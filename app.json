{
  "expo": {
    "name": "MMU Smart Parking Finder App",
    "slug": "campus-smart-parking-finder-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "smartparkingmmu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.sharvin28.campussmartparkingfinderapp",
      "googleServicesFile": "./google-services.json",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sharvin28.campussmartparkingfinderapp",
      "googleServicesFile": "./google-services.json",
      "config": {
    "googleMaps": {
      "apiKey": "AIzaSyAlkMrfBOYBIXnWKVtYqC7rTR_eNRi9sDk"
    }
  }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/app-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad352684-6736-437f-9e12-c5b0d8e20347"
      }
    },
    "owner": "sharvin28"
  }
}
